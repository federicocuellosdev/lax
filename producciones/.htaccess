# =====================================================================
# LAX Producciones — .htaccess para Ferozo / DonWeb (Apache o LiteSpeed)
# Reemplaza public/_redirects y public/_headers (que son sólo de Netlify y no entran en el zip de Ferozo).
# Todo va dentro de <IfModule>: un módulo ausente nunca debe causar un 500.
# Rutas canónicas (src/lib/site.ts y sitemap.xml): "/" y "/evaluar" (sin barra final).
# =====================================================================

DirectoryIndex index.html
# La carpeta evaluar/ existe (copia para Netlify); sin esto Apache haría 301 /evaluar -> /evaluar/ antes de
# que actúe el rewrite de abajo. Con Off, /evaluar se sirve (200) desde evaluar.html.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>
Options -Indexes
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------
# Redirecciones y rutas (mod_rewrite)
# ---------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) www. -> host sin www, ya en https (un solo salto, 301)
  RewriteCond %{HTTP_HOST} ^www\.(.+?)(:\d+)?$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # 2) HTTPS (también detrás de un proxy que informa X-Forwarded-Proto). localhost queda exento para pruebas.
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteCond %{HTTP:X-Forwarded-SSL} !on [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 3) Rutas heredadas / duplicadas -> URL canónica (301). THE_REQUEST sólo mira la petición externa,
  #    así la reescritura interna de abajo no provoca bucles.
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s/index\.html[\s?]
  RewriteRule ^index\.html$ / [R=301,L]

  RewriteCond %{THE_REQUEST} ^[A-Z]+\s/evaluar(\.html|/index\.html|/)[\s?]
  RewriteRule ^evaluar(\.html|/index\.html|/)$ /evaluar [R=301,L]

  RewriteRule ^onboarding/?$ /evaluar [R=301,L]

  # 4) /evaluar (200) se sirve del archivo pre-renderizado evaluar.html. Existe también la carpeta evaluar/
  #    (para Netlify), por eso se reescribe a mano: así Apache no manda el 301 de DirectorySlash a /evaluar/.
  RewriteRule ^evaluar$ /evaluar.html [L]

  # 5) Sin catch-all de SPA: todo lo demás que no sea un archivo real cae en ErrorDocument (404 real).

  # 6) Bloqueos: datos del rate limit y cualquier cosa de /api/ salvo lead.php; archivos ocultos
  RewriteRule ^api/(?!lead\.php$) - [F,L]
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>

# Respaldo de los bloqueos si mod_rewrite no estuviera
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<FilesMatch "\.(log|json|sqlite|bak|sql|env)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ---------------------------------------------------------------------
# Tipos MIME
# ---------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
  AddType image/avif .avif
  AddType image/svg+xml .svg .svgz
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType font/woff2 .woff2
  AddType text/javascript .js .mjs
  AddDefaultCharset UTF-8
</IfModule>

# ---------------------------------------------------------------------
# Compresión (Brotli si está, y deflate como respaldo). No se comprimen imágenes raster, video ni woff2.
# ---------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json application/xml text/xml image/svg+xml image/x-icon
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json application/xml text/xml image/svg+xml image/x-icon
</IfModule>

# ---------------------------------------------------------------------
# Cabeceras de seguridad (equivale a "/*" de _headers). "always" para que también salgan en 404/403.
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always unset X-Powered-By
</IfModule>

# ---------------------------------------------------------------------
# Caché (equivale a _headers)
# /assets lleva hash en el nombre; /img y /video NO: al reemplazar un archivo hay que renombrarlo.
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/(assets|img|video)/" LAX_IMMUTABLE=1
  SetEnvIf Request_URI "^/docs/" LAX_DOCS=1

  Header set Cache-Control "public, max-age=31536000, immutable" env=LAX_IMMUTABLE
  Header set Cache-Control "public, max-age=3600, must-revalidate" env=LAX_DOCS

  # Íconos sin hash, manifest, imagen social: un día
  <FilesMatch "^(favicon\.svg|favicon\.ico|favicon-32\.png|apple-touch-icon\.png|icon-[0-9]+\.png|site\.webmanifest|og-image\.jpg|lax-producciones\.svg)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # HTML, sitemap y robots: siempre revalidar
  <FilesMatch "\.html$|^(sitemap\.xml|robots\.txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Respaldo si no hubiera mod_headers: expiraciones equivalentes
<IfModule !mod_headers.c>
  <IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 day"
    ExpiresByType text/html "access plus 0 seconds"
  </IfModule>
</IfModule>
